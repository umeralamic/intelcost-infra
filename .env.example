# The bench carries its own values inline in docker-compose.yml, because they are
# dev-only and being able to read them in one place is worth more here than secrecy.
#
# This file exists for the one thing that is not: if you point the bench at real
# external services, put those values in a .env beside the compose file.
#
# Nothing here is a secret. Nothing here may be reused anywhere real.

POSTGRES_USER=intelcost
POSTGRES_PASSWORD=intelcost
POSTGRES_DB=intelcost

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Generate a real one for any deployed environment: openssl rand -hex 32
JWT_SECRET=bench-only-secret-not-for-anything-real
