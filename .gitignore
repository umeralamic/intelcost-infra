# regress.sh keeps each fixture's full output here.
.regress/
# regress.sh holds this while it runs (one run at a time).
.regress.lock/

# Claude Code runtime state, not a workspace file.
workspace/.claude/scheduled_tasks.lock

# Real credentials for the legacy site. Never commit.
.env.legacy
# The AI provider's real keys, loaded by the api (F14). Never commit.
.env.ai
# The fixture suite is tracked (D-1057); its run output, screenshots and the sheet key's real drawings are not.
fx-suite/.regress/
fx-suite/.regress.lock
fx-suite/sheet-key/
fx-suite/**/node_modules/
fx-suite/**/shots/
fx-suite/**/*.pdf
browser/.qt-run.*

# Founder reference workbooks with job figures (2026-11-06): never in the mirror or a commit.
workspace/docs/reference/Mohave_AZ_all_crafts_labor_comparison.xlsx
workspace/docs/reference/DE MAIN SOURCE FILE*
