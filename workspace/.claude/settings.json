{
  "permissions": {
    "allow": [
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout umer-dev:*)",
      "Bash(git switch umer-dev:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull origin umer-dev:*)",
      "Bash(git push origin umer-dev)",
      "Bash(git push origin umer-dev:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git stash:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(curl:*)",
      "Bash(bash intelcost-infra/*)",
      "Bash(bash ./*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(diff:*)",
      "Bash(date:*)",
      "Bash(rsync:*)",
      "PowerShell(docker:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push origin umer-dev)",
      "PowerShell(npm:*)",
      "PowerShell(node:*)",
      "PowerShell(curl:*)",
      "Read(//e/Intelcost/**)",
      "Edit(//e/Intelcost/**)",
      "Write(//e/Intelcost/**)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /c:*)",
      "Bash(sed -i:*)",
      "Bash(perl -i:*)",
      "Bash(perl -pi:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-inplace-edit.sh\"",
            "timeout": 10,
            "statusMessage": "Checking hard rule 7 (no in-place sed/perl)"
          }
        ]
      }
    ]
  }
}
