# deploy/.env: what the api and the worker read on the box (D-842). Copy to deploy/.env and fill in; it is git-ignored.
# The names are the api's own settings (intelcost-app-fastapi/app/config.py); its README says what each one does.
ENVIRONMENT=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
REDIS_URL=redis://<host>:6379/0
JWT_SECRET=
CORS_ORIGINS=["https://app.intelcost.io"]
APP_URL=https://app.intelcost.io
S3_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The deploy itself (read by compose.yml, not the api).
# API_IMAGE=intelcost-api:latest        a registry image for `rollout.sh --pull`
# API_SOURCE=../../intelcost-app-fastapi  the api's source for a build on the box
# API_SITE=api.intelcost.io             Caddy's site; ":80" serves plain HTTP (a check, never production)
# API_PROCESSES=3
