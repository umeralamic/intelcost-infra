# The api's and worker's outside-service keys (F14, D-940, D-1031). Copy to .env.ai (git-ignored) and fill in.
# Read when the container is created: after a change, `docker compose up -d --force-recreate api worker`.
# Never print, log, copy or commit a value.
GEMINI_API_KEY=
OPENAI_API_KEY=
# EIA open data key, for the weekly fuel refresh (D-940).
EIA_API_KEY=
# BLS public data key, for OEWS and ECI (D-1031). Empty: the files in BLS_BULK_DIR, one warning.
BLS_API_KEY=
